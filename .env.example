# Copy to .env. NEVER commit the real .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://trailmatch:trailmatch@db:5432/trailmatch
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_at_least_32_chars_random_value
JWT_EXPIRE_MINUTES=60
# ML / payments: "disabled" (default) or "mock" (forbidden when ENVIRONMENT=production)
ML_MODE=mock
PAYMENT_MODE=mock
BOOKING_HOLD_MINUTES=15
CORS_ORIGINS=["http://localhost:3000"]
